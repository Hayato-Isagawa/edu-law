---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import LawRow from "../components/LawRow.astro";

const laws = (await getCollection("laws")).sort(
  (a, b) => a.data.order - b.data.order,
);

const scenarios = [
  {
    title: "いじめ対応",
    summary: "いじめ防止対策推進法 / 学校教育法(出席停止・懲戒)",
    href: "/laws/bullying-prevention-act/",
    group: "child",
  },
  {
    title: "教材コピー(著作物の授業利用)",
    summary: "著作権法 35 条 / 授業目的公衆送信補償金制度",
    href: "/laws/copyright-act/",
    group: "child",
  },
  {
    title: "保護者からの開示請求",
    summary: "個人情報の保護に関する法律 / 教育データの利活用に係る留意事項",
    href: "/laws/personal-information-protection-act/",
    group: "child",
  },
  {
    title: "児童虐待の発見・通告",
    summary: "児童虐待防止法 / 児童福祉法 / 学校教育法",
    href: "/laws/child-abuse-prevention-act/",
    group: "child",
  },
  {
    title: "教員免許の確認・更新",
    summary: "教育職員免許法 / 文部科学省「教員免許状に関する Q&A」",
    href: "/laws/teacher-license-act/",
    group: "child",
  },
  {
    title: "体罰・懲戒の境界",
    summary: "学校教育法第 11 条 / 生徒指導提要(改訂版)",
    href: "/laws/school-education-act/",
    group: "child",
  },
  {
    title: "保護者からの過剰な苦情・不当要求",
    summary: "保護者対応をめぐる公的な支援と相談先(ガイド)",
    href: "/guides/parent-response/",
    group: "teacher",
  },
  {
    title: "教職員のメンタルヘルス・休職",
    summary: "メンタルヘルスと休職・復職をめぐる公的な支援と相談先(ガイド)",
    href: "/guides/teacher-mental-health/",
    group: "teacher",
  },
  {
    title: "公務災害(過労・負傷)の認定と補償",
    summary: "公務災害の認定と補償をめぐる公的な情報(ガイド)",
    href: "/guides/occupational-injury/",
    group: "teacher",
  },
  {
    title: "教員の長時間労働・働き方改革",
    summary: "長時間労働と働き方改革をめぐる国の方針(ガイド)",
    href: "/guides/work-style-reform/",
    group: "teacher",
  },
  {
    title: "教員の懲戒・分限処分と不服申立て",
    summary: "懲戒・分限処分と不服申立てをめぐる公的な情報(ガイド)",
    href: "/guides/disciplinary-disposition/",
    group: "teacher",
  },
] as const;

const highlights = [
  {
    badge: "mext" as const,
    title: "生徒指導提要(改訂版)",
    summary: "文部科学省、令和 4 年 12 月",
    href: "/laws/school-education-act/",
    meta: "学校教育法",
  },
  {
    badge: "mext" as const,
    title: "教員免許状に関するQ&A",
    summary: "文部科学省(随時更新)",
    href: "/laws/teacher-license-act/",
    meta: "教育職員免許法",
  },
  {
    badge: "mext" as const,
    title: "いじめの防止等のための基本的な方針(平成 29 年最終改定)",
    summary: "文部科学大臣決定、平成 29 年 3 月最終改定",
    href: "/laws/bullying-prevention-act/",
    meta: "いじめ防止対策推進法",
  },
  {
    badge: "mext" as const,
    title: "学校・教育委員会等向け 虐待対応の手引き(令和 2 年 6 月改訂版)",
    summary: "文部科学省、令和 2 年 6 月",
    href: "/laws/child-abuse-prevention-act/",
    meta: "児童虐待防止法",
  },
  {
    badge: "bunkacho" as const,
    title: "授業目的公衆送信補償金制度の概要(令和 2 年 12 月)",
    summary: "文化庁、令和 2 年 12 月",
    href: "/laws/copyright-act/",
    meta: "著作権法",
  },
  {
    badge: "mext" as const,
    title: "教育データの利活用に係る留意事項(第 4 版)公立学校編",
    summary: "文部科学省、令和 8 年 4 月",
    href: "/laws/personal-information-protection-act/",
    meta: "個人情報保護法",
  },
  {
    badge: "cfa" as const,
    title: "「子ども虐待対応の手引き」の一部改正(令和 6 年 4 月改正版)",
    summary: "こども家庭庁支援局虐待防止対策課、令和 6 年 4 月",
    href: "/laws/child-welfare-act/",
    meta: "児童福祉法",
  },
] as const;

---

<Layout
  title="EduLaw JP — 教師向け教育法ポータル"
  description="公式に立ち返り、教師の判断を支える教育法ポータル。教育関連法と公式解説(文科省・文化庁・厚労省・e-Gov)を法令別に整理し、自前の法解釈は加えず、公式 URL への入口に徹します。"
>
  <section class="pt-10 sm:pt-14 md:pt-20 lg:pt-28 pb-10 sm:pb-14 md:pb-20">
    <p
      class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]"
    >
      Statutes and official commentary, one path
    </p>
    <p class="mt-1 text-xs text-[var(--color-sub)]">
      小学校教員のための教育法ポータル
    </p>
    <h1
      class="mt-5 font-black text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.15] tracking-tight"
    >
      <span class="text-[var(--color-accent)]">条文</span>と<span
        class="text-[var(--color-accent)]">公式解説</span
      >を、<br />
      教師の判断へ。
    </h1>
    <p
      class="mt-6 max-w-2xl text-[var(--color-ink)] font-bold text-base sm:text-lg leading-snug"
    >
      判断の前に、原典を一度。
    </p>
    <p
      class="mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-[var(--color-sub)]"
    >
      教育関連法と公式解説(文科省・文化庁・厚労省・e-Gov)を、教師の実務文脈で
      <strong class="text-[var(--color-ink)]">探しやすく</strong> 整理します。
    </p>
  </section>

  <section
    class="py-12 border-t border-[var(--color-line)]"
    aria-labelledby="entrances-heading"
  >
    <header class="mb-6">
      <p
        class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]"
      >
        Entrances — 2 つの入口
      </p>
      <h2
        id="entrances-heading"
        class="mt-2 text-2xl sm:text-3xl font-black tracking-tight"
      >
        何をお探しですか
      </h2>
      <p class="mt-3 text-sm text-[var(--color-sub)] leading-relaxed max-w-2xl">
        目的から入口を選べます。本サイトは判断を示さず、所管法令と公的な支援の場所のみを示します。
      </p>
    </header>

    <nav aria-label="2 つの入口" class="grid gap-3 sm:grid-cols-2">
      <a
        href="#scenarios-child"
        class="group block border border-[var(--color-line)] p-5 transition hover:border-[var(--color-accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2"
      >
        <span class="flex items-baseline justify-between gap-2">
          <span
            class="text-lg sm:text-xl font-black tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors"
            >子供への指導・対応</span
          >
          <span
            aria-hidden="true"
            class="text-base text-[var(--color-sub)] transition group-hover:translate-x-1"
            >→</span
          >
        </span>
        <span class="mt-2 block text-sm text-[var(--color-sub)] leading-relaxed">
          児童生徒への対応の法的根拠
        </span>
      </a>
      <a
        href="#scenarios-teacher"
        class="group block border border-[var(--color-line)] p-5 transition hover:border-[var(--color-accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2"
      >
        <span class="flex items-baseline justify-between gap-2">
          <span
            class="text-lg sm:text-xl font-black tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors"
            >教師を守る</span
          >
          <span
            aria-hidden="true"
            class="text-base text-[var(--color-sub)] transition group-hover:translate-x-1"
            >→</span
          >
        </span>
        <span class="mt-2 block text-sm text-[var(--color-sub)] leading-relaxed">
          教師自身の立場と公的な支援
        </span>
      </a>
    </nav>
  </section>

  <section
    id="scenarios-child"
    class="py-12 border-t border-[var(--color-line)] scroll-mt-20"
    aria-labelledby="scenarios-child-heading"
  >
    <header class="mb-6">
      <p
        class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]"
      >
        Children — 子供への指導・対応
      </p>
      <h2
        id="scenarios-child-heading"
        class="mt-2 text-2xl sm:text-3xl font-black tracking-tight"
      >
        児童生徒への対応の法的根拠
      </h2>
      <p class="mt-3 text-sm text-[var(--color-sub)] leading-relaxed max-w-2xl">
        場面ごとに関連法令への入口を整理します。本サイトは判断を示さず、所管法令の場所のみを示します。
      </p>
    </header>

    <div>
      {
        scenarios
          .filter((scenario) => scenario.group === "child")
          .map((scenario, i) => (
            <LawRow
              index={i + 1}
              href={scenario.href}
              title={scenario.title}
              summary={scenario.summary}
              variant="scenario"
            />
          ))
      }
    </div>
  </section>

  <section
    id="scenarios-teacher"
    class="py-12 border-t border-[var(--color-line)] scroll-mt-20"
    aria-labelledby="scenarios-teacher-heading"
  >
    <header class="mb-6">
      <p
        class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]"
      >
        Teachers — 教師を守る
      </p>
      <h2
        id="scenarios-teacher-heading"
        class="mt-2 text-2xl sm:text-3xl font-black tracking-tight"
      >
        教師自身の立場と公的な支援
      </h2>
      <p class="mt-3 text-sm text-[var(--color-sub)] leading-relaxed max-w-2xl">
        不当な要求・心身の不調・公務災害・長時間労働・身分上の処分などに直面したときの、公的な支援と相談先の所在を整理します。
      </p>
    </header>

    <div>
      {
        scenarios
          .filter((scenario) => scenario.group === "teacher")
          .map((scenario, i) => (
            <LawRow
              index={i + 1}
              href={scenario.href}
              title={scenario.title}
              summary={scenario.summary}
              variant="scenario"
            />
          ))
      }
    </div>
  </section>

  <section
    class="py-12 border-t border-[var(--color-line)]"
    aria-labelledby="laws-heading"
  >
    <header class="mb-6 flex flex-wrap items-baseline justify-between gap-4">
      <div>
        <p
          class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]"
        >
          Laws — 整理対象
        </p>
        <h2
          id="laws-heading"
          class="mt-2 text-2xl sm:text-3xl font-black tracking-tight"
        >
          整理対象の 7 法令
        </h2>
      </div>
      <a
        href="/laws/"
        class="link-underline text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2"
      >
        一覧へ <span aria-hidden="true">→</span>
      </a>
    </header>

    <div>
      {
        laws.map((law, i) => (
          <LawRow
            index={i + 1}
            href={`/laws/${law.id}/`}
            title={law.data.title}
            summary={law.data.summary}
            meta={`公式解説 ${law.data.officialExplanations.length} 件`}
            variant="law"
          />
        ))
      }
    </div>
  </section>

  <section
    class="py-12 border-t border-[var(--color-line)]"
    aria-labelledby="highlights-heading"
  >
    <header class="mb-6">
      <p
        class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]"
      >
        Official Highlights — 公式解説の代表
      </p>
      <h2
        id="highlights-heading"
        class="mt-2 text-2xl sm:text-3xl font-black tracking-tight"
      >
        公式解説 Highlights
      </h2>
      <p class="mt-3 text-sm text-[var(--color-sub)] leading-relaxed max-w-2xl">
        所管省庁の代表的な公式解説を、対応する法令ページへの入口として並べます。
      </p>
      <dl
        class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-[11px] text-[var(--color-sub)]"
        aria-label="所管省庁ラベルの凡例"
      >
        <div class="inline-flex items-baseline gap-1.5">
          <dt class="font-mono uppercase tracking-widest text-[var(--badge-mext)]">MEXT</dt>
          <dd>文部科学省</dd>
        </div>
        <div class="inline-flex items-baseline gap-1.5">
          <dt class="font-mono uppercase tracking-widest text-[var(--badge-cfa)]">CFA</dt>
          <dd>こども家庭庁</dd>
        </div>
        <div class="inline-flex items-baseline gap-1.5">
          <dt class="font-mono uppercase tracking-widest text-[var(--badge-bunkacho)]">BUNKACHO</dt>
          <dd>文化庁</dd>
        </div>
        <div class="inline-flex items-baseline gap-1.5">
          <dt class="font-mono uppercase tracking-widest text-[var(--badge-egov)]">E-GOV</dt>
          <dd>e-Gov 法令検索</dd>
        </div>
      </dl>
    </header>

    <div>
      {
        highlights.map((h, i) => (
          <LawRow
            index={i + 1}
            href={h.href}
            title={h.title}
            summary={h.summary}
            badge={h.badge}
            meta={h.meta}
            variant="highlight"
          />
        ))
      }
    </div>
  </section>

  <section
    class="py-12 border-t border-[var(--color-line)]"
    aria-labelledby="stance-heading"
  >
    <p
      class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]"
    >
      Our Stance — 編集方針
    </p>
    <h2
      id="stance-heading"
      class="mt-2 text-2xl sm:text-3xl font-black tracking-tight"
    >
      本サイトの立場
    </h2>
    <div
      class="mt-6 space-y-5 text-sm sm:text-base leading-relaxed text-[var(--color-sub)] max-w-2xl"
    >
      <p>
        <strong class="text-[var(--color-ink)]"
          >公式 URL までの最短経路を整理する。</strong
        >
        e-Gov・文部科学省・文化庁・こども家庭庁に散らばった解説を、法令ごとに 1 ページへ集約します。
      </p>
      <p>
        <strong class="text-[var(--color-ink)]"
          >公式解説の見出し構造を提示する。</strong
        >
        本文の独自要約・解釈は付けず、項目の場所と所管を示します。判断は読者が一次資料に当たって行います。
      </p>
      <p>
        <strong class="text-[var(--color-ink)]"
          >引用は政府標準利用規約 第 2.0 版に準拠する。</strong
        >
        引用は<a
          href="https://www.kantei.go.jp/jp/singi/it2/cio/dai55/siryou3-2.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="link-underline"
          >政府標準利用規約 第 2.0 版</a
        >の範囲内に限り、出典・URL・取得日を必ず明記します。
      </p>
      <p
        class="mt-2 pt-4 border-t border-[var(--color-line)] text-[var(--color-ink)]"
      >
        本サイトは独自の法解釈を加えません。判断が必要な場面では、所管庁・教育委員会・法務担当者にご相談ください。
      </p>
      <p class="text-sm">
        <a
          href="/about/"
          class="link-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2"
          >→ 引用ルールとサイトの立場(About)</a
        >
      </p>
    </div>
  </section>

</Layout>
