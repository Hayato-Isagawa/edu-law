---
import Kicker from "../components/Kicker.astro";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import LawRow from "../components/LawRow.astro";
import { changelogEntries, typeLabel } from "../data/changelog";
import {
  sceneCategories,
  getSceneIndex,
  getAllScenes,
  type Scene,
} from "../data/scenes";

const laws = (await getCollection("laws")).sort(
  (a, b) => a.data.order - b.data.order,
);

const sceneIndex = getSceneIndex(sceneCategories);
const featuredSceneSlugs = [
  "bullying",
  "parent-response",
  "teacher-mental-health",
  "disciplinary-disposition",
];
const featuredScenes = featuredSceneSlugs
  .map((slug) => sceneIndex.get(slug))
  .filter(
    (e): e is { scene: Scene; categoryTitle: string } => e !== undefined,
  );
const totalScenes = getAllScenes(sceneCategories).length;

const highlights = [
  {
    badge: "mext" as const,
    title: "生徒指導提要(改訂版)",
    summary: "文部科学省、令和 4 年 12 月",
    href: "/laws/school-education-act/",
    meta: "学校教育法",
  },
  {
    badge: "mext" as const,
    title: "教員免許状に関するQ&A",
    summary: "文部科学省(随時更新)",
    href: "/laws/teacher-license-act/",
    meta: "教育職員免許法",
  },
  {
    badge: "mext" as const,
    title: "いじめの防止等のための基本的な方針(平成29年最終改定)",
    summary: "文部科学大臣決定、平成 29 年 3 月最終改定",
    href: "/laws/bullying-prevention-act/",
    meta: "いじめ防止対策推進法",
  },
  {
    badge: "mext" as const,
    title: "学校・教育委員会等向け虐待対応の手引き(令和8年5月改訂版)",
    summary: "文部科学省、令和 8 年 5 月",
    href: "/laws/child-abuse-prevention-act/",
    meta: "児童虐待防止法",
  },
  {
    badge: "bunkacho" as const,
    title: "授業目的公衆送信補償金制度の概要(令和2年12月)",
    summary: "文化庁、令和 2 年 12 月",
    href: "/laws/copyright-act/",
    meta: "著作権法",
  },
  {
    badge: "mext" as const,
    title: "教育データの利活用に係る留意事項(第4版)公立学校編",
    summary: "文部科学省、令和 8 年 4 月",
    href: "/laws/personal-information-protection-act/",
    meta: "個人情報保護法",
  },
  {
    badge: "cfa" as const,
    title: "令和4年6月に成立した改正児童福祉法について",
    summary: "こども家庭庁",
    href: "/laws/child-welfare-act/",
    meta: "児童福祉法",
  },
  {
    badge: "mext" as const,
    title: "教師の資質向上に関する指針・ガイドライン",
    summary: "文部科学省",
    href: "/laws/educational-public-service-special-act/",
    meta: "教育公務員特例法",
  },
  {
    badge: "soumu" as const,
    title: "地方公務員制度等",
    summary: "総務省",
    href: "/laws/local-public-service-act/",
    meta: "地方公務員法",
  },
  {
    badge: "mext" as const,
    title: "学校保健、学校給食、食育",
    summary: "文部科学省",
    href: "/laws/school-health-and-safety-act/",
    meta: "学校保健安全法",
  },
  {
    badge: "mext" as const,
    title: "教育基本法資料室へようこそ！",
    summary: "文部科学省",
    href: "/laws/basic-act-on-education/",
    meta: "教育基本法",
  },
  {
    badge: "mext" as const,
    title:
      "義務教育の段階における普通教育に相当する教育の機会の確保等に関する基本指針の策定について(通知)",
    summary: "文部科学省、平成 29 年 3 月",
    href: "/laws/education-opportunity-assurance-act/",
    meta: "教育機会確保法",
  },
] as const;

---

<Layout
  title="EduLaw JP — 教師向け教育法ポータル"
  description="公式に立ち返り、教師の判断を支える教育法ポータル。教育関連法と公式解説(文科省・文化庁・厚労省・e-Gov)を法令別に整理し、自前の法解釈は加えず、公式 URL への入口に徹します。"
>
  <section class="pt-10 sm:pt-14 md:pt-20 lg:pt-28 pb-10 sm:pb-14 md:pb-20">
    <Kicker>
      Statutes and official commentary, one path
    </Kicker>
    <p class="mt-1 text-xs text-sub">
      小学校教員のための教育法ポータル
    </p>
    <h1
      class="mt-5 font-black text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.15] tracking-tight"
    >
      <span class="text-accent">条文</span>と<span
        class="text-accent">公式解説</span
      >を、<br />
      教師の判断へ。
    </h1>
    <p
      class="mt-6 max-w-2xl text-ink font-bold text-base sm:text-lg leading-snug"
    >
      判断の前に、原典を一度。
    </p>
    <p
      class="mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-sub"
    >
      教育関連法と公式解説(文科省・文化庁・厚労省・e-Gov)を、教師の実務文脈で
      <strong class="text-ink">探しやすく</strong> 整理します。
    </p>
  </section>

  <section
    class="py-12 border-t border-line"
    aria-labelledby="scenes-cta-heading"
  >
    <div class="grid grid-cols-12 gap-6 mb-6">
      <div class="col-span-12 min-[900px]:col-span-8 space-y-2">
        <Kicker>
          Scenes — 場面から探す
        </Kicker>
        <h2
          id="scenes-cta-heading"
          class="font-black text-3xl md:text-4xl tracking-tight leading-[1.2]"
        >
          現場の<span class="text-accent">困りごと</span
          >から、法令と公式解説を探す。
        </h2>
        <p class="text-sm text-sub leading-relaxed pt-1 max-w-2xl">
          困りごとから、関連する法令と公式解説・ガイドへの入口に進めます。本サイトは判断を示さず、所管法令と公的な情報の所在のみを示します。
        </p>
      </div>
      <div
        class="col-span-12 min-[900px]:col-span-4 flex min-[900px]:items-end min-[900px]:justify-end"
      >
        <a
          href="/scenes/"
          class="group inline-flex items-center justify-between gap-3 rounded-full border border-accent bg-accent px-5 py-3 text-sm font-bold text-white dark:text-bg motion-safe:transition motion-safe:duration-200 motion-safe:ease-out hover:bg-accent-hover hover:border-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
        >
          <span class="text-white dark:text-bg">全{totalScenes}件の場面を見る</span>
          <span
            class="text-white dark:text-bg motion-safe:transition group-hover:translate-x-0.5"
            aria-hidden="true">→</span
          >
        </a>
      </div>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        featuredScenes.map(({ scene, categoryTitle }) => {
          const lawCount = scene.lawSlugs.length;
          const guideCount = scene.guides?.length ?? 0;
          const titleId = `featured-${scene.slug}-title`;
          return (
            <li>
              <a
                href={`/scenes/#${scene.slug}`}
                aria-labelledby={titleId}
                class="group block h-full rounded-xl border border-line bg-card p-5 space-y-3 motion-safe:transition motion-safe:duration-200 motion-safe:ease-out hover:border-accent focus-visible:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
              >
                <Kicker as="div" tone="sub" size="2xs">
                  {categoryTitle}
                </Kicker>
                <h3
                  id={titleId}
                  class="font-black text-base leading-snug motion-safe:transition group-hover:text-accent group-focus-visible:text-accent"
                >
                  {scene.title}
                </h3>
                <p class="text-xs text-sub leading-relaxed line-clamp-3">
                  {scene.description}
                </p>
                <div class="flex items-center gap-3 pt-1 text-[11px] text-sub">
                  {lawCount > 0 && (
                    <span>
                      <span class="font-bold text-ink">
                        {lawCount}
                      </span>
                      件の法令
                    </span>
                  )}
                  {guideCount > 0 && (
                    <span>
                      <span class="font-bold text-ink">
                        {guideCount}
                      </span>
                      件のガイド
                    </span>
                  )}
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section
    class="py-12 border-t border-line"
    aria-labelledby="laws-heading"
  >
    <header class="mb-6 flex flex-wrap items-baseline justify-between gap-4">
      <div>
        <Kicker>
          Laws — 対象法令
        </Kicker>
        <h2
          id="laws-heading"
          class="mt-2 text-2xl sm:text-3xl font-black tracking-tight"
        >
          対象の 12 法令
        </h2>
      </div>
      <a
        href="/laws/"
        class="link-underline text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
      >
        一覧へ <span aria-hidden="true">→</span>
      </a>
    </header>

    <div>
      {
        laws.map((law, i) => (
          <LawRow
            index={i + 1}
            href={`/laws/${law.id}/`}
            title={law.data.title}
            summary={law.data.summary}
            meta={`公式解説 ${law.data.officialExplanations.length} 件`}
            variant="law"
          />
        ))
      }
    </div>
  </section>

  <section
    class="py-12 border-t border-line"
    aria-labelledby="updates-heading"
  >
    <header class="mb-6 flex flex-wrap items-baseline justify-between gap-4">
      <div>
        <Kicker>
          Updates — 最近の更新
        </Kicker>
        <h2
          id="updates-heading"
          class="mt-2 text-2xl sm:text-3xl font-black tracking-tight"
        >
          最近の更新
        </h2>
      </div>
      <a
        href="/changelog/"
        class="link-underline text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
      >
        更新履歴へ <span aria-hidden="true">→</span>
      </a>
    </header>

    <ul class="space-y-5">
      {
        changelogEntries.slice(0, 3).map((entry) =>
          entry.items.map((item) => {
            const t = typeLabel[item.type];
            return (
              <li class="flex flex-wrap gap-x-3 gap-y-1 items-start text-sm leading-[1.625em]">
                <span class="font-mono text-xs leading-[inherit] text-accent shrink-0">
                  {entry.date}
                </span>
                <span
                  class={`font-mono text-xs leading-[inherit] uppercase tracking-widest shrink-0 ${t.color}`}
                >
                  {t.label}
                </span>
                <span class="w-full sm:w-auto sm:flex-1 sm:min-w-0">
                  <span class="line-clamp-2">{item.text}</span>
                  {item.links && (
                    <span class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs">
                      {item.links.map((l) => (
                        <a href={l.href} class="link-underline">
                          {l.label} <span aria-hidden="true">→</span>
                        </a>
                      ))}
                    </span>
                  )}
                </span>
              </li>
            );
          }),
        )
      }
    </ul>
  </section>

  <section
    class="py-12 border-t border-line"
    aria-labelledby="highlights-heading"
  >
    <header class="mb-6">
      <Kicker>
        Official Highlights — 公式解説の代表
      </Kicker>
      <h2
        id="highlights-heading"
        class="mt-2 text-2xl sm:text-3xl font-black tracking-tight"
      >
        公式解説 Highlights
      </h2>
      <p class="mt-3 text-sm text-sub leading-relaxed max-w-2xl">
        所管省庁の代表的な公式解説を、対応する法令ページへの入口として並べます。
      </p>
      <dl
        class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-[11px] text-sub"
        aria-label="所管省庁ラベルの凡例"
      >
        <div class="inline-flex items-baseline gap-1.5">
          <dt class="font-mono uppercase tracking-widest text-badge-mext">MEXT</dt>
          <dd>文部科学省</dd>
        </div>
        <div class="inline-flex items-baseline gap-1.5">
          <dt class="font-mono uppercase tracking-widest text-badge-cfa">CFA</dt>
          <dd>こども家庭庁</dd>
        </div>
        <div class="inline-flex items-baseline gap-1.5">
          <dt class="font-mono uppercase tracking-widest text-badge-bunkacho">BUNKACHO</dt>
          <dd>文化庁</dd>
        </div>
        <div class="inline-flex items-baseline gap-1.5">
          <dt class="font-mono uppercase tracking-widest text-badge-soumu">SOUMU</dt>
          <dd>総務省</dd>
        </div>
        <div class="inline-flex items-baseline gap-1.5">
          <dt class="font-mono uppercase tracking-widest text-badge-egov">E-GOV</dt>
          <dd>e-Gov 法令検索</dd>
        </div>
      </dl>
    </header>

    <div>
      {
        highlights.map((h, i) => (
          <LawRow
            index={i + 1}
            href={h.href}
            title={h.title}
            summary={h.summary}
            badge={h.badge}
            meta={h.meta}
            variant="highlight"
          />
        ))
      }
    </div>
  </section>

  <section
    class="py-12 border-t border-line"
    aria-labelledby="stance-heading"
  >
    <Kicker>
      Our Stance — 編集方針
    </Kicker>
    <h2
      id="stance-heading"
      class="mt-2 text-2xl sm:text-3xl font-black tracking-tight"
    >
      本サイトの立場
    </h2>
    <div
      class="mt-6 space-y-5 text-sm sm:text-base leading-relaxed text-sub max-w-2xl"
    >
      <p>
        <strong class="text-ink"
          >公式 URL までの最短経路を整理する。</strong
        >
        e-Gov・文部科学省・文化庁・こども家庭庁に散らばった解説を、法令ごとに 1 ページへ集約します。
      </p>
      <p>
        <strong class="text-ink"
          >公式解説の見出し構造を提示する。</strong
        >
        本文の独自要約・解釈は付けず、項目の場所と所管を示します。判断は読者が一次資料に当たって行います。
      </p>
      <p>
        <strong class="text-ink"
          >引用は公共データ利用規約 第 1.0 版に準拠する。</strong
        >
        引用は<a
          href="https://www.digital.go.jp/resources/open_data/public_data_license_v1.0"
          target="_blank"
          rel="noopener noreferrer"
          class="link-underline"
          >公共データ利用規約 第 1.0 版</a
        >の範囲内に限り、出典・URL・取得日を必ず明記します。
      </p>
      <p
        class="mt-2 pt-4 border-t border-line text-ink"
      >
        本サイトは独自の法解釈を加えません。判断が必要な場面では、所管庁・教育委員会・法務担当者にご相談ください。
      </p>
      <p class="text-sm">
        <a
          href="/about/"
          class="link-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
          >→ 引用ルールとサイトの立場(About)</a
        >
      </p>
    </div>
  </section>

</Layout>
