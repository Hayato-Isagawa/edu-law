---
import Kicker from "../components/Kicker.astro";
import Layout from "../layouts/Layout.astro";
import { changelogEntries, typeLabel } from "../data/changelog";
---

<Layout title="更新履歴 — EduLaw JP">
  <section class="pt-10 sm:pt-14 md:pt-20 lg:pt-28 pb-10 sm:pb-14 md:pb-20 border-b border-line">
    <Kicker size="2xs">
      Changelog
    </Kicker>
    <h1
      class="mt-5 font-black text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.15] tracking-tight"
    >
      更新履歴
    </h1>
    <p class="mt-6 text-sub text-sm sm:text-base leading-loose max-w-2xl">
      サイトの機能追加・公式解説の更新・修正を時系列で記録しています。
    </p>
  </section>

  <section class="pb-24">
    {
      changelogEntries.map((entry) => (
        <div id={`d-${entry.date}`} class="border-t border-line py-10 space-y-4">
          <div class="font-mono text-sm text-accent">
            {entry.date}
          </div>
          <ul class="space-y-3">
            {entry.items.map((item) => {
              const t = typeLabel[item.type];
              return (
                <li class="flex gap-3 items-baseline text-sm leading-relaxed">
                  <span
                    class={`font-mono text-xs uppercase tracking-widest shrink-0 ${t.color}`}
                  >
                    {t.label}
                  </span>
                  <span>
                    {item.text}
                    {item.links && (
                      <span class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 text-xs">
                        {item.links.map((l) => (
                          <a href={l.href} class="link-underline">
                            {l.label} <span aria-hidden="true">→</span>
                          </a>
                        ))}
                      </span>
                    )}
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
    <div class="border-t border-line"></div>
  </section>
</Layout>
