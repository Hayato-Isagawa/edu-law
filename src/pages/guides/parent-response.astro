---
import Layout from "../../layouts/Layout.astro";

const pageTitle = "保護者対応をめぐる公的な支援と相談先 — EduLaw JP";
const pageDescription =
  "保護者からの過剰な苦情や不当な要求について、文部科学省・教育委員会・教職員支援機構・スクールロイヤーなど公的な支援と相談先の所在を整理するガイド。本サイトは対処法を判断せず、公式情報への入口のみを示します。";

const siteUrl = "https://law.edu-evidence.org";
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "ガイド", item: `${siteUrl}/guides/` },
    {
      "@type": "ListItem",
      position: 3,
      name: "保護者対応をめぐる公的な支援と相談先",
      item: `${siteUrl}/guides/parent-response/`,
    },
  ],
};

type GuideLink = { label: string; publisher: string; url: string; format?: "pdf" };
type GuideSection = {
  id: string;
  number: string;
  title: string;
  lead: string;
  links: GuideLink[];
};

const sections: GuideSection[] = [
  {
    id: "support-mext-heading",
    number: "1",
    title: "国(文部科学省)の取組",
    lead: "文部科学省は、学校における働き方改革の一環として、保護者等からの過剰な苦情や不当な要求への対応を施策に位置づけています。取組の全体像と、行政による支援体制づくりの情報が公開されています。",
    links: [
      {
        label: "保護者等からの過剰な苦情や不当な要求への対応に関する取組について",
        publisher: "文部科学省",
        url: "https://www.mext.go.jp/a_menu/shotou/hatarakikata/mext_00013.html",
      },
    ],
  },
  {
    id: "support-board-heading",
    number: "2",
    title: "教育委員会の手引き",
    lead: "全国の都道府県・指定都市の教育委員会が、保護者対応の手引きやマニュアルを整備しています。文部科学省が、それらの自治体版を集約して一覧で公開しています。",
    links: [
      {
        label:
          "保護者等からの過剰な苦情や不当な要求への対応に関する教育委員会における取組について",
        publisher: "文部科学省(各教育委員会の手引きへのリンク集)",
        url: "https://www.mext.go.jp/a_menu/shotou/hatarakikata/mext_00600.html",
      },
    ],
  },
  {
    id: "support-training-heading",
    number: "3",
    title: "研修・教材",
    lead: "独立行政法人教職員支援機構(NITS)が、保護者との関係づくりに関する研修動画を公開しています。",
    links: [
      {
        label: "研修動画教材",
        publisher: "教職員支援機構(NITS)",
        url: "https://www.nits.go.jp/materials/",
      },
    ],
  },
  {
    id: "support-lawyer-heading",
    number: "4",
    title: "法務相談(スクールロイヤー)",
    lead: "教育委員会が弁護士に法務相談できる体制(スクールロイヤー)の整備が、国の財政措置とともに進められています。体制づくりのための手引きや調査結果が公開されています。",
    links: [
      {
        label: "教育行政に係る法務相談体制の充実について",
        publisher: "文部科学省",
        url: "https://www.mext.go.jp/a_menu/houmusoudan/index.htm",
      },
      {
        label: "教育行政に係る法務相談体制構築に向けた手引き(第3版)",
        publisher: "文部科学省",
        url: "https://www.mext.go.jp/content/20251022-mxt_syoto01-000011909.pdf",
        format: "pdf",
      },
    ],
  },
  {
    id: "support-kasuhara-heading",
    number: "5",
    title: "最新動向 — 自治体による保護者対応の指針",
    lead: "保護者等への対応をめぐっては、家庭・地域と学校の関係づくりに関する指針を整える自治体が出てきています。動きの速い領域のため、最新の内容は各公式情報でご確認ください。",
    links: [
      {
        label: "七飯町立学校におけるカスタマーハラスメントへの対応等について",
        publisher: "七飯町教育委員会",
        url: "https://www.town.nanae.hokkaido.jp/education/detail/00017231.html",
      },
      {
        label:
          "「学校と家庭・地域とのより良好な関係づくりに係るガイドライン」の策定について",
        publisher: "東京都教育委員会",
        url: "https://www.kyoiku.metro.tokyo.lg.jp/information/press/2026/02/2026020204",
      },
      {
        label: "家庭・地域と学校の良好な関係の維持・向上に向けて",
        publisher: "川崎市教育委員会",
        url: "https://www.city.kawasaki.jp/880/page/0000187557.html",
      },
    ],
  },
  {
    id: "support-laws-heading",
    number: "6",
    title: "参考 — 教師の立場に関わる法令",
    lead: "保護者対応をめぐって、教師自身の立場に関わる法令です。本サイトは解釈を加えず、e-Gov 法令検索の本文への入口のみを示します。",
    links: [
      {
        label: "地方公務員法",
        publisher: "e-Gov 法令検索",
        url: "https://laws.e-gov.go.jp/law/325AC0000000261/",
      },
      {
        label: "労働安全衛生法",
        publisher: "e-Gov 法令検索",
        url: "https://laws.e-gov.go.jp/law/347AC0000000057/",
      },
    ],
  },
];

const linkClass =
  "link-underline inline-flex items-baseline gap-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2";
const breadcrumbLinkClass =
  "link-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbJsonLd={breadcrumbJsonLd}
  longForm
>
  <nav aria-label="パンくず" class="pt-6 sm:pt-10">
    <ol
      class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-[var(--color-sub)]"
    >
      <li><a href="/" class={breadcrumbLinkClass}>ホーム</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/guides/" class={breadcrumbLinkClass}>ガイド</a></li>
      <li aria-hidden="true">/</li>
      <li>
        <span aria-current="page" class="text-[var(--color-ink)]"
          >保護者対応をめぐる公的な支援と相談先</span
        >
      </li>
    </ol>
  </nav>

  <section class="pt-6 sm:pt-10 pb-8 sm:pb-12">
    <p
      class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]"
    >
      Guide
    </p>
    <h1
      class="mt-5 font-black text-4xl sm:text-5xl md:text-6xl leading-[1.15] tracking-tight"
    >
      保護者対応をめぐる<br />公的な<span class="text-[var(--color-accent)]"
        >支援と相談先</span
      >
    </h1>
    <div
      class="mt-6 max-w-2xl text-[var(--color-sub)] leading-loose text-sm sm:text-base space-y-3"
    >
      <p>
        保護者からの過剰な苦情や不当な要求への対応には、<strong
          class="text-[var(--color-ink)]"
          >国・教育委員会・専門家による公的な支援と相談の枠組み</strong
        >があります。このページは、それらがどこにあるかを整理します。
      </p>
      <p>
        本サイトは対応の良し悪しや具体的な対処法を判断しません(<a
          href="/about/"
          class={breadcrumbLinkClass}>サイトの立場</a
        >)。示すのは公式情報の所在のみです。判断が必要な場面では、所管庁・教育委員会・法務担当者にご相談ください。
      </p>
    </div>
  </section>

  <div class="space-y-12 pb-12">
    {
      sections.map((section) => (
        <section
          aria-labelledby={section.id}
          class="space-y-4 text-sm sm:text-base text-[var(--color-sub)] leading-loose"
        >
          <h2
            id={section.id}
            class="text-xl sm:text-2xl font-black text-[var(--color-ink)]"
          >
            <span class="text-[var(--color-accent)] font-mono text-base sm:text-lg">
              {section.number}
            </span>{" "}
            {section.title}
          </h2>
          <p>{section.lead}</p>
          <ul class="space-y-3">
            {section.links.map((link) => (
              <li class="space-y-0.5">
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={linkClass}
                >
                  {link.label}
                  {link.format === "pdf" ? "(PDF)" : ""}
                  <span aria-hidden="true" class="text-[var(--color-sub)] text-xs">
                    ↗
                  </span>
                </a>
                <span class="block text-xs text-[var(--color-sub)]">
                  {link.publisher}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <footer
    class="mt-4 mb-16 border-t border-[var(--color-line)] pt-6 text-xs text-[var(--color-sub)] leading-relaxed space-y-2"
    aria-labelledby="guide-footer-heading"
  >
    <h2 id="guide-footer-heading" class="sr-only">本ページの根拠</h2>
    <p>
      本ページが案内する公式情報は、取得日 2026-06-08
      時点で各公式サイトに公開されているものです。リンク先の最新の内容は、各公式サイトでご確認ください。
    </p>
    <p>
      引用ルールは <a
        href="/about/#citation-basis-heading"
        class={breadcrumbLinkClass}
        >引用の根拠 — 公共データ利用規約 第 1.0 版</a
      > を参照してください。
    </p>
  </footer>
</Layout>
