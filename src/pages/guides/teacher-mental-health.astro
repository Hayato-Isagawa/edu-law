---
import Layout from "../../layouts/Layout.astro";

const pageTitle =
  "教員のメンタルヘルスと休職・復職をめぐる公的な支援と相談先 — EduLaw JP";
const pageDescription =
  "教員の心の不調や、それに伴う休職・復職、公務災害の認定について、文部科学省・厚生労働省・地方公務員災害補償基金など公的な支援と相談先の所在を整理するガイド。本サイトは可否を判断せず、公式情報への入口のみを示します。";

const siteUrl = "https://law.edu-evidence.org";
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "ガイド", item: `${siteUrl}/guides/` },
    {
      "@type": "ListItem",
      position: 3,
      name: "教員のメンタルヘルスと休職・復職",
      item: `${siteUrl}/guides/teacher-mental-health/`,
    },
  ],
};

type GuideLink = { label: string; publisher: string; url: string; format?: "pdf" };
type GuideSection = {
  id: string;
  number: string;
  title: string;
  lead: string;
  links: GuideLink[];
};

const sections: GuideSection[] = [
  {
    id: "mh-mext-heading",
    number: "1",
    title: "国(文部科学省)の取組",
    lead: "文部科学省は、教職員のメンタルヘルス対策を、予防(セルフケア・ラインケア)から復職支援までの施策として進めています。取組の全体像と関連資料が公開されています。",
    links: [
      {
        label: "教職員のメンタルヘルス対策について",
        publisher: "文部科学省",
        url: "https://www.mext.go.jp/a_menu/shotou/kyoin/mental_00008.html",
      },
    ],
  },
  {
    id: "mh-guides-heading",
    number: "2",
    title: "休職・復職を支える手引き",
    lead: "心の不調による病気休暇・病気休職と、その後の復職を支えるため、文部科学省が管理職向け・休職中の教職員向けの手引きを公開しています。",
    links: [
      {
        label: "コンパス 教職員のメンタルヘルスを支援するための手引き",
        publisher: "文部科学省(学校管理職向け)",
        url: "https://www.mext.go.jp/content/20260409-mxt_syoto01-000036019_8.pdf",
        format: "pdf",
      },
      {
        label: "とまり木 心の不調による病気休暇・病気休職中の手引き",
        publisher: "文部科学省(病気休暇・病気休職中の教職員向け)",
        url: "https://www.mext.go.jp/content/20260409-mxt_syoto01-000036019_9.pdf",
        format: "pdf",
      },
    ],
  },
  {
    id: "mh-stress-check-heading",
    number: "3",
    title: "ストレスチェック制度(予防)",
    lead: "労働安全衛生法に基づくストレスチェック制度について、厚生労働省が制度の説明と資料を公開しています。動きのある領域のため、最新の内容は各公式情報でご確認ください。",
    links: [
      {
        label: "ストレスチェック制度・メンタルヘルス対策",
        publisher: "厚生労働省",
        url: "https://www.mhlw.go.jp/bunya/roudoukijun/anzeneisei12/index.html",
      },
      {
        label: "こころの耳 — 働く人のメンタルヘルス・ポータルサイト",
        publisher: "厚生労働省",
        url: "https://kokoro.mhlw.go.jp/etc/kaiseianeihou/",
      },
    ],
  },
  {
    id: "mh-compensation-heading",
    number: "4",
    title: "公務災害の認定(精神疾患)",
    lead: "公務に起因する精神疾患等の災害補償は、地方公務員災害補償基金が扱います。認定の可否は個別の判断であり、本サイトは判断しません。制度と相談の入口を示します。",
    links: [
      {
        label: "地方公務員災害補償基金",
        publisher: "地方公務員災害補償基金",
        url: "https://www.chikousai.go.jp/",
      },
      {
        label: "通達(認定)",
        publisher: "地方公務員災害補償基金",
        url: "https://www.chikousai.go.jp/reiki/tuutatu-nintei/tuutatu-nintei.php",
      },
    ],
  },
  {
    id: "mh-laws-heading",
    number: "5",
    title: "参考 — 教師の立場に関わる法令",
    lead: "メンタルヘルスや災害補償に関わる法令です。本サイトは解釈を加えず、e-Gov 法令検索の本文への入口のみを示します。",
    links: [
      {
        label: "労働安全衛生法",
        publisher: "e-Gov 法令検索",
        url: "https://laws.e-gov.go.jp/law/347AC0000000057/",
      },
      {
        label: "地方公務員災害補償法",
        publisher: "e-Gov 法令検索",
        url: "https://laws.e-gov.go.jp/law/342AC0000000121/",
      },
    ],
  },
];

const linkClass =
  "link-underline inline-flex items-baseline gap-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2";
const breadcrumbLinkClass =
  "link-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbJsonLd={breadcrumbJsonLd}
>
  <nav aria-label="パンくず" class="pt-6 sm:pt-10">
    <ol
      class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-[var(--color-sub)]"
    >
      <li><a href="/" class={breadcrumbLinkClass}>ホーム</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/guides/" class={breadcrumbLinkClass}>ガイド</a></li>
      <li aria-hidden="true">/</li>
      <li>
        <span aria-current="page" class="text-[var(--color-ink)]"
          >教員のメンタルヘルスと休職・復職</span
        >
      </li>
    </ol>
  </nav>

  <section class="pt-6 sm:pt-10 pb-8 sm:pb-12">
    <p
      class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]"
    >
      Guide
    </p>
    <h1
      class="mt-5 font-black text-4xl sm:text-5xl md:text-6xl leading-[1.15] tracking-tight"
    >
      メンタルヘルスと休職・<br />復職をめぐる<span
        class="text-[var(--color-accent)]">公的な支援</span
      >
    </h1>
    <div
      class="mt-6 max-w-2xl text-[var(--color-sub)] leading-loose text-sm sm:text-base space-y-3"
    >
      <p>
        教員の心の不調や、それに伴う休職・復職には、<strong
          class="text-[var(--color-ink)]"
          >国・自治体・専門機関による公的な支援と相談の枠組み</strong
        >があります。このページは、それらがどこにあるかを整理します。
      </p>
      <p>
        本サイトは症状や認定の可否、具体的な対処法を判断しません(<a
          href="/about/"
          class={breadcrumbLinkClass}>サイトの立場</a
        >)。示すのは公式情報の所在のみです。判断が必要な場面では、医療機関・所管庁・教育委員会・基金にご相談ください。
      </p>
    </div>
  </section>

  <div class="space-y-12 pb-12">
    {
      sections.map((section) => (
        <section
          aria-labelledby={section.id}
          class="space-y-4 text-sm sm:text-base text-[var(--color-sub)] leading-loose"
        >
          <h2
            id={section.id}
            class="text-xl sm:text-2xl font-black text-[var(--color-ink)]"
          >
            <span class="text-[var(--color-accent)] font-mono text-base sm:text-lg">
              {section.number}
            </span>{" "}
            {section.title}
          </h2>
          <p>{section.lead}</p>
          <ul class="space-y-3">
            {section.links.map((link) => (
              <li class="space-y-0.5">
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={linkClass}
                >
                  {link.label}
                  {link.format === "pdf" ? "(PDF)" : ""}
                  <span aria-hidden="true" class="text-[var(--color-sub)] text-xs">
                    ↗
                  </span>
                </a>
                <span class="block text-xs text-[var(--color-sub)]">
                  {link.publisher}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <footer
    class="mt-4 mb-16 border-t border-[var(--color-line)] pt-6 text-xs text-[var(--color-sub)] leading-relaxed space-y-2"
    aria-labelledby="guide-footer-heading"
  >
    <h2 id="guide-footer-heading" class="sr-only">本ページの根拠</h2>
    <p>
      本ページが案内する公式情報は、取得日 2026-05-24
      時点で各公式サイトに公開されているものです。リンク先の最新の内容は、各公式サイトでご確認ください。
    </p>
    <p>
      引用ルールは <a
        href="/about/#citation-basis-heading"
        class={breadcrumbLinkClass}
        >引用の根拠 — 政府標準利用規約 第 2.0 版</a
      > を参照してください。
    </p>
  </footer>
</Layout>
