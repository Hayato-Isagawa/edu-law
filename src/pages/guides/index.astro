---
import Layout from "../../layouts/Layout.astro";

const pageTitle = "ガイド — EduLaw JP";
const pageDescription =
  "教師が教育法を読む前提を整理するガイド。法令階層の基礎、保護者対応、教員のメンタルヘルスと休職・復職をめぐる公的な支援と相談先。";

const siteUrl = "https://law.edu-evidence.org";
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "ガイド", item: `${siteUrl}/guides/` },
  ],
};

type Guide = { title: string; description: string; href: string };
const guides: Guide[] = [
  {
    title: "日本の法令階層",
    description:
      "憲法・法律・政令・省令・告示・通知が、それぞれ誰の手で作られ、どの法令を根拠とするのかを整理します。",
    href: "/guides/legal-hierarchy/",
  },
  {
    title: "保護者対応をめぐる公的な支援と相談先",
    description:
      "保護者からの過剰な苦情や不当な要求について、文部科学省・教育委員会・スクールロイヤー等の公的な支援と相談先の所在を整理します。",
    href: "/guides/parent-response/",
  },
  {
    title: "教員のメンタルヘルスと休職・復職をめぐる公的な支援と相談先",
    description:
      "教員の心の不調による休職・復職や公務災害の認定について、文部科学省・厚生労働省・地方公務員災害補償基金等の公的な支援と相談先の所在を整理します。",
    href: "/guides/teacher-mental-health/",
  },
];

const linkClass =
  "link-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbJsonLd={breadcrumbJsonLd}
>
  <nav aria-label="パンくず" class="pt-6 sm:pt-10">
    <ol
      class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-[var(--color-sub)]"
    >
      <li><a href="/" class={linkClass}>ホーム</a></li>
      <li aria-hidden="true">/</li>
      <li>
        <span aria-current="page" class="text-[var(--color-ink)]">ガイド</span>
      </li>
    </ol>
  </nav>

  <section class="pt-6 sm:pt-10 pb-8 sm:pb-12">
    <p
      class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]"
    >
      Guides
    </p>
    <h1
      class="mt-5 font-black text-4xl sm:text-5xl md:text-6xl leading-[1.15] tracking-tight"
    >
      ガイド
    </h1>
    <p
      class="mt-6 max-w-2xl text-[var(--color-sub)] leading-loose text-sm sm:text-base"
    >
      法令本文に触れる前提となる基礎と、現場の場面ごとに公的情報の所在を整理したまとめです。
    </p>
  </section>

  <div class="border-t border-[var(--color-line)]">
    {
      guides.map((guide) => (
        <article class="py-6 border-b border-[var(--color-line)]">
          <h2 class="text-xl sm:text-2xl font-black text-[var(--color-ink)]">
            <a href={guide.href} class={linkClass}>
              {guide.title}
            </a>
          </h2>
          <p class="mt-2 max-w-2xl text-sm sm:text-base text-[var(--color-sub)] leading-relaxed">
            {guide.description}
          </p>
          <a href={guide.href} class={`${linkClass} mt-3 inline-block text-sm`}>
            開く <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
</Layout>
