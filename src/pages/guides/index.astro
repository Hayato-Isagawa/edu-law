---
import Layout from "../../layouts/Layout.astro";

const pageTitle = "ガイド — EduLaw JP";
const pageDescription =
  "教師が教育法を読む前提を整理するガイド。法令階層の基礎、保護者対応、教員のメンタルヘルスと休職・復職、公務災害の認定と補償、長時間労働と働き方改革、懲戒・分限処分と不服申立て、学校管理下の事故の補償と責任、妊娠・出産・育児と仕事の両立、非正規の教員の任用と勤務条件をめぐる公的な情報の所在。";

const siteUrl = "https://law.edu-evidence.org";
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "ガイド", item: `${siteUrl}/guides/` },
  ],
};

type Guide = {
  title: string;
  description: string;
  href: string;
  category: "foundation" | "teacher";
};
const guides: Guide[] = [
  {
    title: "日本の法令階層",
    description:
      "憲法・法律・政令・省令・告示・通知が、それぞれ誰の手で作られ、どの法令を根拠とするのかを整理します。",
    href: "/guides/legal-hierarchy/",
    category: "foundation",
  },
  {
    title: "保護者対応をめぐる公的な支援と相談先",
    description:
      "保護者からの過剰な苦情や不当な要求について、文部科学省・教育委員会・スクールロイヤー等の公的な支援と相談先の所在を整理します。",
    href: "/guides/parent-response/",
    category: "teacher",
  },
  {
    title: "教員のメンタルヘルスと休職・復職をめぐる公的な支援と相談先",
    description:
      "教員の心の不調による休職・復職について、文部科学省・厚生労働省等の公的な支援と相談先の所在を整理します。公務災害の認定と補償は専用ガイドに案内します。",
    href: "/guides/teacher-mental-health/",
    category: "teacher",
  },
  {
    title: "教員の公務災害(認定と補償)をめぐる公的な情報",
    description:
      "公務上の負傷や過労による疾患(精神疾患・脳血管疾患・心臓疾患)の公務災害認定と、補償の種類・認定請求の手続について、地方公務員災害補償基金・e-Gov 等の公的な情報の所在を整理します。",
    href: "/guides/occupational-injury/",
    category: "teacher",
  },
  {
    title: "教員の長時間労働と働き方改革をめぐる国の方針と公式資料",
    description:
      "教員の長時間勤務の是正と働き方改革について、文部科学省の方針・勤務時間の上限に関する指針・給特法等の公的な方針と資料の所在を整理します。",
    href: "/guides/work-style-reform/",
    category: "teacher",
  },
  {
    title: "教員の懲戒・分限処分と不服申立てをめぐる公的な情報",
    description:
      "教員の懲戒処分・分限処分と、不利益処分を受けたときの審査請求について、文部科学省・総務省・人事委員会等の公的な情報の所在を整理します。",
    href: "/guides/disciplinary-disposition/",
    category: "teacher",
  },
  {
    title: "学校管理下の事故の補償と責任をめぐる公的な情報",
    description:
      "学校管理下で児童生徒等が事故にあったときの災害共済給付、文部科学省の学校事故対応指針、関わる法令について、日本スポーツ振興センター・e-Gov 等の公的な情報の所在を整理します。",
    href: "/guides/school-accident/",
    category: "teacher",
  },
  {
    title: "教員の妊娠・出産・育児と仕事の両立をめぐる公的な情報",
    description:
      "教員(地方公務員)の妊娠・出産・育児と仕事の両立について、産前産後休暇・育児休業・部分休業などの制度と、総務省『地方公務員 両立支援パスポート』・e-Gov 等の公的な情報の所在を整理します。",
    href: "/guides/childcare-work-balance/",
    category: "teacher",
  },
  {
    title: "非正規の教員(臨時的任用・会計年度任用)の任用と勤務条件をめぐる公的な情報",
    description:
      "公立学校の臨時的任用職員・会計年度任用職員(いわゆる非正規の教員)の任用と勤務条件について、総務省『会計年度任用職員制度の運用に係る事務処理マニュアル』・文部科学省・e-Gov 等の公的な情報の所在を整理します。",
    href: "/guides/non-regular-teachers/",
    category: "teacher",
  },
];

const guideGroups = [
  {
    label: "読む前の基礎",
    items: guides.filter((g) => g.category === "foundation"),
  },
  {
    label: "教師を守る",
    items: guides.filter((g) => g.category === "teacher"),
  },
] as const;

const linkClass =
  "link-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbJsonLd={breadcrumbJsonLd}
>
  <nav aria-label="パンくず" class="pt-6 sm:pt-10">
    <ol
      class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-[var(--color-sub)]"
    >
      <li><a href="/" class={linkClass}>ホーム</a></li>
      <li aria-hidden="true">/</li>
      <li>
        <span aria-current="page" class="text-[var(--color-ink)]">ガイド</span>
      </li>
    </ol>
  </nav>

  <section class="pt-6 sm:pt-10 pb-8 sm:pb-12">
    <p
      class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]"
    >
      Guides
    </p>
    <h1
      class="mt-5 font-black text-4xl sm:text-5xl md:text-6xl leading-[1.15] tracking-tight"
    >
      ガイド
    </h1>
    <p
      class="mt-6 max-w-2xl text-[var(--color-sub)] leading-loose text-sm sm:text-base"
    >
      法令本文に触れる前提となる基礎と、現場の場面ごとに公的情報の所在を整理したまとめです。
    </p>
  </section>

  {
    guideGroups.map((group) => (
      <section class="mt-12 first:mt-0">
        <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--color-accent)]">
          {group.label}
        </h2>
        <div class="mt-4 border-t border-[var(--color-line)]">
          {group.items.map((guide) => (
            <article class="py-6 border-b border-[var(--color-line)]">
              <h3 class="text-xl sm:text-2xl font-black text-[var(--color-ink)]">
                <a href={guide.href} class={linkClass}>
                  {guide.title}
                </a>
              </h3>
              <p class="mt-2 max-w-2xl text-sm sm:text-base text-[var(--color-sub)] leading-relaxed">
                {guide.description}
              </p>
              <a href={guide.href} class={`${linkClass} mt-3 inline-block text-sm`}>
                開く <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </section>
    ))
  }
</Layout>
