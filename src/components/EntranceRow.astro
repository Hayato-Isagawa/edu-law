---
interface Props {
  href: string;
  title: string;
  description: string;
}

const { href, title, description } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col py-6 border-b border-[var(--color-line)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2"
>
  <h3
    class="text-xl sm:text-2xl font-black text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-accent)]"
  >
    {title}
  </h3>
  <p
    class="mt-2 max-w-2xl text-sm sm:text-base text-[var(--color-sub)] leading-relaxed"
  >
    {description}
  </p>
  <span
    aria-hidden="true"
    class="mt-3 self-end text-base text-[var(--color-sub)] transition group-hover:translate-x-1"
  >
    →
  </span>
</a>
