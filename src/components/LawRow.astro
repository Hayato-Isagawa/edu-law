---
interface Props {
  index: number;
  total: number;
  href: string;
  title: string;
  summary?: string;
  badge?: "mext" | "cfa" | "bunkacho" | "egov" | "leaf" | "sprout" | "root";
  meta?: string;
  variant?: "law" | "scenario" | "highlight" | "sister";
  isCurrent?: boolean;
}

const {
  index,
  total,
  href,
  title,
  summary,
  badge,
  meta,
  variant = "law",
  isCurrent = false,
} = Astro.props;

const num = `${String(index).padStart(2, "0")}/${String(total).padStart(2, "0")}`;

const publisherBadgeConfig = {
  mext: {
    label: "MEXT",
    style:
      "text-[var(--badge-mext)] border-[var(--badge-mext)]/40 bg-[var(--badge-mext)]/10",
  },
  cfa: {
    label: "CFA",
    style:
      "text-[var(--badge-cfa)] border-[var(--badge-cfa)]/40 bg-[var(--badge-cfa)]/10",
  },
  bunkacho: {
    label: "BUNKACHO",
    style:
      "text-[var(--badge-bunkacho)] border-[var(--badge-bunkacho)]/40 bg-[var(--badge-bunkacho)]/10",
  },
  egov: {
    label: "E-GOV",
    style:
      "text-[var(--badge-egov)] border-[var(--badge-egov)]/40 bg-[var(--badge-egov)]/10",
  },
} as const;

const sisterBadgeConfig = {
  leaf: { label: "葉" },
  sprout: { label: "双葉" },
  root: { label: "根" },
} as const;

type PublisherKey = keyof typeof publisherBadgeConfig;
type SisterKey = keyof typeof sisterBadgeConfig;

const isPublisherBadge = (b: typeof badge): b is PublisherKey =>
  b === "mext" || b === "cfa" || b === "bunkacho" || b === "egov";
const isSisterBadge = (b: typeof badge): b is SisterKey =>
  b === "leaf" || b === "sprout" || b === "root";

const arrow = isCurrent ? "◉" : "→";
---

{
  isCurrent ? (
    <div
      class="law-row"
      data-variant={variant}
      data-current="true"
      aria-current="page"
    >
      <div class="col-span-2 font-mono text-sm text-[var(--color-sub)]" data-num>
        {num}
      </div>
      <div class="col-span-10 sm:col-span-7 space-y-1">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="text-lg sm:text-xl font-black tracking-tight leading-snug text-[var(--color-ink)]">
            {title}
          </h3>
          {badge && isSisterBadge(badge) && (
            <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-sub)]">
              {sisterBadgeConfig[badge].label}
            </span>
          )}
        </div>
        {summary && (
          <p class="text-sm text-[var(--color-sub)] leading-relaxed">
            {summary}
          </p>
        )}
      </div>
      <div class="col-span-12 sm:col-span-3 sm:text-right font-mono text-xs text-[var(--color-sub)] flex sm:justify-end items-center gap-2">
        {meta && <span>{meta}</span>}
        <span aria-hidden="true" class="text-base">
          {arrow}
        </span>
      </div>
    </div>
  ) : (
    <a class="law-row group" href={href} data-variant={variant}>
      <div class="col-span-2 font-mono text-sm text-[var(--color-sub)]" data-num>
        {num}
      </div>
      <div class="col-span-10 sm:col-span-7 space-y-1">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="text-lg sm:text-xl font-black tracking-tight leading-snug text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">
            {title}
          </h3>
          {badge && isPublisherBadge(badge) && (
            <span
              class={`font-mono text-[10px] tracking-widest uppercase border rounded-full px-2 py-0.5 leading-none inline-flex items-center h-5 ${publisherBadgeConfig[badge].style}`}
            >
              {publisherBadgeConfig[badge].label}
            </span>
          )}
          {badge && isSisterBadge(badge) && (
            <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-sub)]">
              {sisterBadgeConfig[badge].label}
            </span>
          )}
        </div>
        {summary && (
          <p class="text-sm text-[var(--color-sub)] leading-relaxed">
            {summary}
          </p>
        )}
      </div>
      <div class="col-span-12 sm:col-span-3 sm:text-right font-mono text-xs text-[var(--color-sub)] flex sm:justify-end items-center gap-2">
        {meta && <span>{meta}</span>}
        <span
          aria-hidden="true"
          class="text-base transition group-hover:translate-x-1"
        >
          {arrow}
        </span>
      </div>
    </a>
  )
}
