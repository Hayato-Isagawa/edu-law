---
interface Props {
  index: number;
  href: string;
  title: string;
  summary?: string;
  badge?: "mext" | "cfa" | "bunkacho" | "soumu" | "egov";
  meta?: string;
  variant?: "law" | "scenario" | "highlight";
}

const {
  index,
  href,
  title,
  summary,
  badge,
  meta,
  variant = "law",
} = Astro.props;

const num = String(index).padStart(2, "0");

const publisherBadgeConfig = {
  mext: {
    label: "MEXT",
    fullLabel: "文部科学省",
    style:
      "text-badge-mext border-badge-mext/40 bg-badge-mext/10",
  },
  cfa: {
    label: "CFA",
    fullLabel: "こども家庭庁",
    style:
      "text-badge-cfa border-badge-cfa/40 bg-badge-cfa/10",
  },
  bunkacho: {
    label: "BUNKACHO",
    fullLabel: "文化庁",
    style:
      "text-badge-bunkacho border-badge-bunkacho/40 bg-badge-bunkacho/10",
  },
  soumu: {
    label: "SOUMU",
    fullLabel: "総務省",
    style:
      "text-badge-soumu border-badge-soumu/40 bg-badge-soumu/10",
  },
  egov: {
    label: "E-GOV",
    fullLabel: "e-Gov 法令検索",
    style:
      "text-badge-egov border-badge-egov/40 bg-badge-egov/10",
  },
} as const;
---

<a class="law-row group" href={href} data-variant={variant}>
  <div class="col-span-2 sm:col-span-1 font-mono text-sm text-sub" data-num>
    {num}
  </div>
  <div class="col-span-10 sm:col-span-8 space-y-1">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-lg sm:text-xl font-black tracking-tight leading-snug text-ink group-hover:text-accent transition-colors">
        {title}
      </h3>
      {badge && (
        <span
          class={`font-mono text-[10px] tracking-widest uppercase border rounded-full px-2 py-0.5 leading-none inline-flex items-center h-5 ${publisherBadgeConfig[badge].style}`}
          title={publisherBadgeConfig[badge].fullLabel}
          aria-label={publisherBadgeConfig[badge].fullLabel}
        >
          {publisherBadgeConfig[badge].label}
        </span>
      )}
    </div>
    {summary && (
      <p class="text-sm text-sub leading-relaxed">
        {summary}
      </p>
    )}
  </div>
  <div class="col-span-12 sm:col-span-3 sm:text-right font-mono text-xs text-sub flex sm:justify-end items-center gap-2">
    {meta && <span>{meta}</span>}
    <span
      aria-hidden="true"
      class="text-base transition group-hover:translate-x-1"
    >
      →
    </span>
  </div>
</a>
