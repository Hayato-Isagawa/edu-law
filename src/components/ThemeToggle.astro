---
interface Props {
  id?: string;
  class?: string;
  /** 文字のラベルを添える(モバイルメニュー) */
  labeled?: boolean;
}

const { id = "theme-toggle", class: className = "", labeled = false } = Astro.props;
const look = labeled
  ? ""
  : "relative flex items-center justify-center w-8 h-8 pointer-coarse:w-11 pointer-coarse:h-11 text-sub hover:text-ink transition-colors";
---

<button
  id={id}
  type="button"
  class={`theme-toggle ${look} ${className}`}
  aria-label="ダークモードに切り替え"
  aria-pressed="false"
>
  <span class={labeled ? "mobile-menu-theme-toggle-icon" : "contents"} aria-hidden="true">
    <svg class="theme-icon-moon w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
    <svg class="theme-icon-sun w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2" />
      <path d="M12 20v2" />
      <path d="m4.93 4.93 1.41 1.41" />
      <path d="m17.66 17.66 1.41 1.41" />
      <path d="M2 12h2" />
      <path d="M20 12h2" />
      <path d="m6.34 17.66-1.41 1.41" />
      <path d="m19.07 4.93-1.41 1.41" />
    </svg>
  </span>
  {labeled && <span class="mobile-menu-theme-toggle-label">ダークモードに切り替え</span>}
</button>
