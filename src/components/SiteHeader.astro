---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  longForm?: boolean;
}
const { longForm = false } = Astro.props;

// ナビの現在地。項目自身のページは page、その下のページは true
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const currentFor = (href: string) => {
  const target = href.replace(/\/$/, "");
  if (currentPath === target) return "page" as const;
  return target !== "" && currentPath.startsWith(`${target}/`)
    ? ("true" as const)
    : undefined;
};
---

<header class="site-header">
  <div
    class="mx-auto max-w-6xl px-4 sm:px-6 md:px-10 h-16 flex items-center justify-between gap-4"
  >
    <a
      href="/"
      class="flex items-center gap-2 whitespace-nowrap font-black text-lg sm:text-xl tracking-tight shrink-0"
    >
      <span class="text-accent inline-flex shrink-0">
        <Logo class="w-8 h-8" />
      </span>
      EduLaw <span class="text-accent">JP</span>
    </a>

    <nav class="hidden lg:flex items-center gap-6 text-sm" aria-label="メインナビゲーション">
      <a
        href="/scenes/"
        class={currentFor("/scenes/")
          ? "text-ink font-semibold pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"
          : "text-sub hover:text-ink transition pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"}
        aria-current={currentFor("/scenes/")}
      >
        場面から探す
      </a>
      <a
        href="/laws/"
        class={currentFor("/laws/")
          ? "text-ink font-semibold pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"
          : "text-sub hover:text-ink transition pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"}
        aria-current={currentFor("/laws/")}
      >
        法令一覧
      </a>
      <a
        href="/guides/"
        class={currentFor("/guides/")
          ? "text-ink font-semibold pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"
          : "text-sub hover:text-ink transition pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"}
        aria-current={currentFor("/guides/")}
      >
        ガイド
      </a>
      <a
        href="/about/"
        class={currentFor("/about/")
          ? "text-ink font-semibold pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"
          : "text-sub hover:text-ink transition pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"}
        aria-current={currentFor("/about/")}
      >
        サイトについて
      </a>
      <a
        href="/changelog/"
        class={currentFor("/changelog/")
          ? "text-ink font-semibold pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"
          : "text-sub hover:text-ink transition pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"}
        aria-current={currentFor("/changelog/")}
      >
        更新履歴
      </a>
      <a
        href="/search/"
        class={currentFor("/search/")
          ? "text-ink pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"
          : "text-sub hover:text-ink transition pointer-coarse:py-3 pointer-coarse:px-2 pointer-coarse:-mx-2"}
        aria-current={currentFor("/search/")}
        aria-label="検索"
      >
        <svg class="w-4 h-4 inline-block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </a>
      <ThemeToggle id="theme-toggle" />
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden relative flex flex-col justify-center items-center gap-1.5 w-10 h-10 -mr-2 shrink-0"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block w-6 h-[2px] bg-ink transition-transform duration-200 origin-center"></span>
      <span class="block w-6 h-[2px] bg-ink transition-opacity duration-200"></span>
      <span class="block w-6 h-[2px] bg-ink transition-transform duration-200 origin-center"></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    data-state="closed"
    class="mobile-menu lg:hidden"
    inert
  >
    <div class="mobile-menu-inner">
      <form
        class="mobile-menu-search"
        action="/search/"
        method="get"
        role="search"
      >
        <label for="mobile-menu-search-input" class="sr-only">検索</label>
        <svg
          class="mobile-menu-search-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <input
          id="mobile-menu-search-input"
          type="search"
          name="q"
          placeholder="法令・ガイド・場面を検索…"
          autocomplete="off"
          enterkeyhint="search"
        />
      </form>

      <nav class="mobile-menu-nav" aria-label="サイトナビゲーション">
        <section class="mobile-menu-section">
          <h2 class="mobile-menu-section-title">Explore — 探す</h2>
          <ul>
            <li>
              <a href="/" aria-current={currentFor("/")}>ホーム</a>
            </li>
            <li>
              <a href="/scenes/" aria-current={currentFor("/scenes/")}>場面から探す</a>
            </li>
            <li>
              <a href="/laws/" aria-current={currentFor("/laws/")}>法令一覧</a>
            </li>
            <li>
              <a href="/guides/" aria-current={currentFor("/guides/")}>ガイド</a>
            </li>
          </ul>
        </section>

        <section class="mobile-menu-section">
          <h2 class="mobile-menu-section-title">About — このサイトについて</h2>
          <ul>
            <li>
              <a href="/about/" aria-current={currentFor("/about/")}>このサイトについて</a>
            </li>
            <li>
              <a href="/changelog/" aria-current={currentFor("/changelog/")}>更新履歴</a>
            </li>
            <li>
              <a href="/rss.xml">RSS フィード</a>
            </li>
          </ul>
        </section>

        <section class="mobile-menu-section">
          <h2 class="mobile-menu-section-title">Sister Sites — 姉妹サイト</h2>
          <ul>
            <li><a href="https://edu-evidence.org">EduEvidence JP — 教育エビデンス</a></li>
            <li><a href="https://news.edu-evidence.org">EduWatch JP — 教育ニュース</a></li>
          </ul>
        </section>

        <section class="mobile-menu-section">
          <h2 class="mobile-menu-section-title">Display — 表示</h2>
          <ThemeToggle
            id="theme-toggle-mobile"
            class="mobile-menu-theme-toggle"
            labeled
          />
        </section>
      </nav>
    </div>
  </div>
  {longForm && (
    <div
      id="reading-progress"
      aria-hidden="true"
      data-progress="0"
    ></div>
  )}
</header>

<script is:inline>
  (function () {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu) return;
    const bars = toggle.querySelectorAll("span");
    let isOpen = false;
    const setOpen = (open) => {
      isOpen = open;
      menu.dataset.state = open ? "open" : "closed";
      document.body.dataset.menu = open ? "open" : "closed";
      if (open) menu.removeAttribute("inert");
      else menu.setAttribute("inert", "");
      // 全面を覆うので、裏の本文には触れさせない(開閉ボタンのあるヘッダーは残す)
      for (const el of document.querySelectorAll("main, body > footer, #back-to-top, .skip-link")) {
        el.toggleAttribute("inert", open);
      }
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
      if (bars.length === 3) {
        bars[0].style.transform = open ? "translateY(8px) rotate(45deg)" : "";
        bars[1].style.opacity = open ? "0" : "";
        bars[2].style.transform = open ? "translateY(-8px) rotate(-45deg)" : "";
      }
      if (open) {
        const searchInput = document.getElementById("mobile-menu-search-input");
        if (searchInput) {
          window.setTimeout(
            () => searchInput.focus({ preventScroll: true }),
            50,
          );
        }
      } else {
        toggle.focus({ preventScroll: true });
      }
    };
    toggle.addEventListener("click", () => setOpen(!isOpen));
    // 同じページ内へのリンクでは遷移が起きないので、押したら閉じる
    menu.addEventListener("click", (e) => {
      if (isOpen && e.target.closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) setOpen(false);
    });
    // メニューを隠す CSS(lg = 64rem)と同じ条件で見る。px で見ると、既定の文字が小さいブラウザで
    // メニューだけ消えて本文が inert のまま残る
    window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => {
      if (e.matches && isOpen) setOpen(false);
    });
  })();
</script>
