{
  "name": "edu-law",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "astro dev",
    "build": "astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:tokens": "npx tsx scripts/check-tokens.ts",
    "check:sources": "node scripts/check-source-titles.mjs",
    "test:content": "node scripts/assert-test-files.mjs 'scripts/__tests__/content/*.test.mjs' && node scripts/assert-test-results.mjs 110 'scripts/__tests__/content/*.test.mjs'",
    "test:workflows": "node scripts/assert-test-files.mjs 'scripts/__tests__/*.test.mjs' && node scripts/assert-test-results.mjs 115 'scripts/__tests__/*.test.mjs'",
    "test:hooks": "node scripts/assert-test-files.mjs '.claude/hooks/__tests__/*.test.cjs' && node scripts/assert-test-results.mjs 110 '.claude/hooks/__tests__/*.test.cjs'",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "vrt": "npx playwright test --config playwright.vrt.config.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/react": "^7.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "pagefind": "^1.5.2",
    "rehype-external-links": "^3.0.0",
    "satori": "^0.62.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "wrangler": "^4.151.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "vite": "^8.0.0",
    "js-yaml": "^4.3.2",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.4.0",
    "undici@^7.0.0": "^7.30.0",
    "yaml": "$yaml",
    "hono": "^4.12.34",
    "body-parser": "^2.3.0",
    "brace-expansion@^1.0.0": "^1.1.17",
    "brace-expansion@^5.0.0": "^5.0.9",
    "postcss": "^8.5.25",
    "fflate": "^0.7.5",
    "compression": "^1.8.2",
    "sharp@<0.35.5": "^0.35.5"
  }
}
