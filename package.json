{
  "name": "edu-law",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "astro dev",
    "build": "astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:tokens": "npx tsx scripts/check-tokens.ts",
    "test:hooks": "node scripts/assert-test-files.mjs '.claude/hooks/__tests__/*.test.cjs' && node scripts/assert-test-results.mjs 50 '.claude/hooks/__tests__/*.test.cjs'",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "vrt": "npx playwright test --config playwright.vrt.config.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "pagefind": "^1.5.2",
    "rehype-external-links": "^3.0.0",
    "satori": "^0.29.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "wrangler": "^4.119.0"
  },
  "overrides": {
    "vite": "^8.0.0",
    "js-yaml": "^4.3.1",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.4.0",
    "undici": "^7.29.0",
    "yaml": "^2.8.3",
    "hono": "^4.12.34",
    "body-parser": "^2.3.0",
    "brace-expansion@^1.0.0": "^1.1.17",
    "brace-expansion@^5.0.0": "^5.0.9",
    "postcss": "^8.5.25"
  }
}
